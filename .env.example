# Supabase Configuration
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Admin Email(s) — comma-separated if multiple
VITE_ADMIN_EMAIL=joyfulmorningblooms@gmail.com,darbensmosier@gmail.com,lovable192181@outlook.com
# For backwards compatibility, VITE_OWNER_EMAIL is also supported
# VITE_OWNER_EMAIL=admin@example.com

# Square Payment Keys
VITE_SQUARE_APP_ID=your_square_app_id
VITE_SQUARE_LOCATION_ID=your_square_location_id

# Local LLM configuration:
# Provide either a local LLM server URL or a local LLM CLI executable path.
# Example (HTTP server): LLM_API_URL=http://127.0.0.1:5000
# Example (local CLI): LLM_CLI_PATH=C:\\path\\to\\ollama.exe
# Optional model name or path for the local LLM:
# LLM_MODEL=llama3:8b

# Piper TTS settings (optional)
# PIPER_API_URL=http://127.0.0.1:59125
# PIPER_CLI_PATH=piper
# PIPER_MODEL=tts_models/en/ljspeech/tacotron2-DDC
# PIPER_VOICE=your_piper_voice_name

